# ==============================================================================
# UNIFIED ENVIRONMENT CONFIGURATION (.env.example) - DOGFOOD HACKATHON PLATFORM
# Copy to .env and customize values for production deployment
# ==============================================================================

# Core Application Settings
APP_ENV=production
SECRET_KEY=change_this_to_a_secure_random_key_in_production
PORT=8080

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg2://dogfood:dogfood@127.0.0.1:5432/dogfood
FIXTURES_PATH=/app/fixtures.json

# Internal & External Service URLs
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Email & SMTP Notifications Configuration
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_FROM_NAME="DOGFOOD Hackathons"
SMTP_USE_TLS=true
